{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{ "command": "tombi format - --stdin-filename {{file_path}}", "exts": ["toml"] },
			{ "command": "just --dump --justfile {{file_path}}", "fileNames": ["justfile"] },
			{ "command": "rustfmt --edition 2024", "exts": ["rs"] },
			{ "command": "sort-package-json --stdin", "fileNames": ["package.json"] },
			{ "command": "gofmt -s", "exts": ["go"] },
			{
				"command": "pwsh -NoProfile -NonInteractive -NoLogo -Command \"\\$ErrorActionPreference='Stop';try{\\$source=[Console]::In.ReadToEnd();\\$formatted=PSScriptAnalyzer\\Invoke-Formatter -ScriptDefinition:\\$source;[Console]::Out.Write(\\$formatted)}catch{[Console]::Error.WriteLine(\\$_.Exception.Message); exit 1}\"",
				"exts": ["ps1", "psm1"],
				"setupCommand": "pwsh -NoProfile -NonInteractive -NoLogo -Command \"\\$ErrorActionPreference='Stop';(Get-Module -Name PSScriptAnalyzer).Version -ne \\$null || try{Install-Module -Name PSScriptAnalyzer -Force -Scope CurrentUser}catch{[Console]::Error.WriteLine(\\$_.Exception.Message); exit 1}\""
			}
		]
	},
	"plugins": ["npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"]
}
